            "url": {
              "raw": "{{baseUrl}}/users/:id/permissions/:permission",
              "host": ["{{baseUrl}}", "users"],
              "path": [":id", "permissions", ":permission"]
            },
            "description": "Revoke permission from user (Admin/Manager)"
